#!/usr/bin/env bash
#
# secure-vault-web — launch the Secure Vault browser UI (SPEC/07).
#
# Uses the project virtualenv and runs the package straight from src/ via
# PYTHONPATH. All arguments are forwarded to `python -m vault.web`
# (e.g. --home, --host, --port, --allow-lan, --unlock-file, --json-events).
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PY="$ROOT/.venv/bin/python"

if [ ! -x "$PY" ]; then
  echo "secure-vault-web: no virtualenv at $ROOT/.venv" >&2
  echo "secure-vault-web: run $ROOT/tools/bootstrap.sh first" >&2
  exit 1
fi

export PYTHONPATH="$ROOT/src${PYTHONPATH:+:$PYTHONPATH}"
exec "$PY" -m vault.web "$@"
